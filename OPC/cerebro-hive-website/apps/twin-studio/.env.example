DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Local development uses the seeded tenant/workspace and ignores x-workspace-id.
# Set TWIN_STUDIO_DEV_AUTH=disabled to require a real session plus workspace membership.
# TWIN_STUDIO_DEV_AUTH=disabled

# Ask Twin uses a real LLM. At least one key is required for questions against stored state.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# AI_PROVIDER=anthropic
