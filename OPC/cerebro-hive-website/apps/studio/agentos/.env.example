# Database. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./agentos.db
# DATABASE_URL=postgresql+psycopg2://agentos:agentos@localhost:5432/agentos

# LLM providers. If none are set, the LLM Gateway falls back to a deterministic
# mock provider so the platform runs fully offline.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Auth
AGENTOS_JWT_SECRET=change-me-in-production

# Production gates — leave both unset for local dev (zero-config, matches
# the rest of this MVP). Set BOTH before deploying anywhere public:
#
# Locks down POST /auth/api-keys — without this, anyone who finds the API
# URL can mint themselves a bearer token. Generate one with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
AGENTOS_ADMIN_SECRET=
# Comma-separated origins allowed to call this API from a browser. Defaults
# to the local Next.js dev server only if unset.
AGENTOS_ALLOWED_ORIGINS=http://localhost:3000

# Governance
AGENTOS_POLICY_FILE=./agentos_policies.yaml
