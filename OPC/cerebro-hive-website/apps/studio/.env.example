# Required Configuration for Cerebro Studio
# Copy this file to .env.local and populate the values

# The canonical endpoint for the Engineering Review API (M26.2 Baseline)
NEXT_PUBLIC_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/v1

# Cognito Authentication Settings (Reference Identity Provider)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
