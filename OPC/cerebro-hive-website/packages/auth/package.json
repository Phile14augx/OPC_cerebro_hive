{
  "name": "@cerebro/auth",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./src/react.ts",
      "default": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "node ../../scripts/eslint-eslintrc.cjs src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test src/rbac/permissions.test.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "@cerebro/db": "workspace:*",
    "express": "^4.19.2",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/react": "^18.2.0",
    "@types/express": "^4.17.21"
  }
}
