{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
    ,"baseUrl": "."
    ,"paths": {
      "@cerebro/twin-contracts": ["../twin-contracts/src/index.ts"],
      "@cerebro/twin-domain": ["../twin-domain/src/index.ts"]
    }
  },
  "include": ["index.ts", "twin-studio.ts", "src/**/*"],
  "exclude": ["node_modules", "dist"]
}
