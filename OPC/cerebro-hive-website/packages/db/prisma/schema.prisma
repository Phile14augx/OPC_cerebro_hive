/// Immutable append-only events generated during executions.
model ExecutionEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid // For tenant isolation
  executionId String   @db.Uuid // Loose relation to WorkflowExecution or AgentExecution
  eventType   String // e.g., ExecutionStarted, ToolInvoked
  eventSource String // e.g., AgentRuntime, WorkflowRuntime
  payload     Json // Event-specific data payload
  timestamp   DateTime @default(now())

  @@index([executionId])
  @@index([workspaceId])
  @@index([eventType])
}

/// Structured checkpoints for pausing/resuming executions.
model ExecutionCheckpoint {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @db.Uuid
  executionId     String   @db.Uuid // Loose relation to WorkflowExecution or AgentExecution
  currentNode     String? // Step or Node ID currently executing
  completedSteps  String[] // Array of completed step/node IDs
  contextSnapshot Json // Snapshot of ExecutionContext
  variables       Json? // Execution variables
  pendingActions  Json? // Queue of pending actions
  eventOffset     Int // Number of events processed at this checkpoint
  createdAt       DateTime @default(now())

  @@index([executionId])
}

