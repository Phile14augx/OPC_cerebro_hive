generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../src/generated/client"
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector"), pgcrypto]
}

// Digital Twin Studio: immutable definition versions and tenant-scoped runtime objects.
model DigitalTwin {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @db.Uuid
  workspaceId     String    @db.Uuid
  name            String
  type            String    @default("GENERIC")
  status          String    @default("DRAFT")
  metadata        Json      @default("{}")
  activeVersionId String? @db.Uuid
  createdBy       String?
  updatedBy       String?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  activeVersion   TwinVersion? @relation("ActiveTwinVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        TwinVersion[] @relation("TwinVersions")
  entities        TwinEntity[]
  stateHistory    TwinEntityState[]
  currentStates   TwinEntityCurrentState[]
  proposals       TwinVersionProposal[]
  scenarios       TwinScenario[]

  @@index([tenantId, workspaceId])
  @@index([tenantId, workspaceId, status, updatedAt(sort: Desc)])
}

model TwinVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  twinId        String   @db.Uuid
  twin          DigitalTwin @relation("TwinVersions", fields: [twinId], references: [id], onDelete: Cascade)
  versionNumber Int
  status        String   @default("DRAFT")
  definition    Json
  sourceProposalId String? @db.Uuid
  createdBy     String?
  publishedAt   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  activeFor     DigitalTwin[] @relation("ActiveTwinVersion")
  entities      TwinEntity[]

  @@unique([twinId, versionNumber])
  @@index([twinId, status, createdAt(sort: Desc)])
}

model TwinEntity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  twinId       String   @db.Uuid
  twin         DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  versionId    String   @db.Uuid
  version      TwinVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  key          String
  name         String
  typeKey      String
  attributes   Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stateHistory TwinEntityState[]
  currentState TwinEntityCurrentState?

  @@unique([twinId, key])
  @@index([twinId, versionId])
}

model TwinEntityState {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  workspaceId    String   @db.Uuid
  twinId         String   @db.Uuid
  twin           DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  entityId       String   @db.Uuid
  entity         TwinEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  versionId      String   @db.Uuid
  state          Json
  provenance     Json
  source         String
  classification String
  confidence     Float?
  observedAt     DateTime
  effectiveAt    DateTime
  ingestedAt     DateTime @default(now())

  @@index([tenantId, workspaceId, twinId, entityId, observedAt(sort: Desc)])
  @@index([tenantId, workspaceId, twinId, effectiveAt(sort: Desc)])
}

model TwinEntityCurrentState {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  workspaceId    String   @db.Uuid
  twinId         String   @db.Uuid
  twin           DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  entityId       String   @unique @db.Uuid
  entity         TwinEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  versionId      String   @db.Uuid
  state          Json
  provenance     Json
  source         String
  classification String
  confidence     Float?
  observedAt     DateTime
  effectiveAt    DateTime
  ingestedAt     DateTime
  updatedAt      DateTime @updatedAt

  @@index([tenantId, workspaceId, twinId])
}

model TwinVersionProposal {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  workspaceId      String   @db.Uuid
  twinId           String   @db.Uuid
  twin             DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  status           String   @default("PREVIEW")
  definition       Json
  provenance       Json
  schemaValid      Boolean
  policyValid      Boolean
  rejectionReason  String?
  createdBy        String?
  appliedVersionId String?  @db.Uuid
  createdAt        DateTime @default(now())
  appliedAt        DateTime?
  rejectedAt       DateTime?

  @@index([tenantId, workspaceId, twinId, status, createdAt(sort: Desc)])
}

model TwinScenario {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  workspaceId String   @db.Uuid
  twinId      String   @db.Uuid
  twin        DigitalTwin @relation(fields: [twinId], references: [id], onDelete: Cascade)
  versionId   String   @db.Uuid
  name        String
  kind        String
  inputs      Json
  createdBy   String?
  createdAt   DateTime @default(now())
  runs        TwinSimulationRun[]

  @@index([tenantId, workspaceId, twinId, createdAt(sort: Desc)])
}

model TwinSimulationRun {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  workspaceId    String   @db.Uuid
  twinId         String   @db.Uuid
  versionId      String   @db.Uuid
  scenarioId     String   @db.Uuid
  scenario       TwinScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  status         String
  snapshot       Json
  result         Json?
  provenance     Json
  errorCode      String?
  startedAt      DateTime @default(now())
  completedAt    DateTime?

  @@index([tenantId, workspaceId, twinId, startedAt(sort: Desc)])
  @@index([scenarioId, startedAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// PHASE 1: PLATFORM FOUNDATION
// -----------------------------------------------------------------------------

model Tenant {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String  @unique
  billingPlan String  @default("enterprise")
  isActive    Boolean @default(true)
  metadata    Json?

  workspaces   Workspace[]
  members      TenantMember[]
  environments Environment[]
  apiKeys      APIKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workspace {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name      String
  slug      String  @unique
  isDefault Boolean @default(false)

  agents    Agent[]
  workflows Workflow[]
  projects  Project[]
  apiKeys   APIKey[]
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model User {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String  @unique
  name      String?
  avatarUrl String?

  tenantMembers TenantMember[]
  sessions      Session[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgMemberships OrgMembership[]
  invitations    Invitation[]    @relation("InvitedBy")
}

model TenantMember {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId   String @db.Uuid
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?

  permissions Permission[]
  members     TenantMember[]

  createdAt DateTime @default(now())
}

model Permission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId   String @db.Uuid
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action   String // e.g. "create:agent", "read:workspace"
  resource String

  @@unique([roleId, action, resource])
}

model APIKey {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspaceId String?    @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name      String
  keyHash   String    @unique
  expiresAt DateTime?

  createdAt DateTime @default(now())
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  resource   String
  resourceId String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
}

model FeatureFlag {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String  @unique
  isEnabled Boolean @default(false)
  rules     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Environment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String // dev, staging, prod

  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// PHASE 2: AI & AGENT DOMAIN
// -----------------------------------------------------------------------------

model Agent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  avatarUrl   String?
  isActive    Boolean @default(true)

  versions      AgentVersion[]
  executions    AgentExecution[]
  conversations AgentConversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AgentVersion {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId String @db.Uuid
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version Int

  modelId String  @db.Uuid
  model   AIModel @relation(fields: [modelId], references: [id], onDelete: Restrict)

  instructions String @db.Text
  config       Json?

  capabilities AgentCapability[]
  tools        AgentTool[]
  prompts      PromptTemplate[]

  createdAt DateTime @default(now())

  @@unique([agentId, version])
}

model AgentCapability {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentVersionId String       @db.Uuid
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  name           String
  config         Json?
}

model Tool {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?

  categoryId String?       @db.Uuid
  category   ToolCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  versions ToolVersion[]

  createdAt DateTime @default(now())
}

model ToolCategory {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name  String
  tools Tool[]
}

model ToolVersion {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toolId  String @db.Uuid
  tool    Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  version Int

  schema      Json
  endpoint    String?
  handlerCode String? @db.Text

  agentVersions AgentTool[]

  createdAt DateTime @default(now())

  @@unique([toolId, version])
}

model AgentTool {
  agentVersionId String       @db.Uuid
  toolVersionId  String       @db.Uuid
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  toolVersion    ToolVersion  @relation(fields: [toolVersionId], references: [id], onDelete: Cascade)

  @@id([agentVersionId, toolVersionId])
}

model PromptTemplate {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentVersionId String       @db.Uuid
  agentVersion   AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade)
  name           String
  template       String       @db.Text
  variables      Json?
}

model KnowledgeSource {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  type String // document, web, database
  uri  String

  collections KnowledgeCollectionSource[]
}

model KnowledgeCollection {
  id      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  sources KnowledgeCollectionSource[]
}

model KnowledgeCollectionSource {
  collectionId String              @db.Uuid
  sourceId     String              @db.Uuid
  collection   KnowledgeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  source       KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([collectionId, sourceId])
}

model Memory {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId String @db.Uuid
  context Json

  snapshots MemorySnapshot[]
}

model MemorySnapshot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memoryId  String   @db.Uuid
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now())
}

model AgentExecution {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId        String @db.Uuid
  agentVersionId String @db.Uuid

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  status   String
  provider String?
  model    String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  costUsd         Float?
  inputTokens     Int?
  outputTokens    Int?
  reasoningTokens Int?

  traceId  String
  metadata Json?

  version Int @default(1) // Optimistic concurrency control

  steps       AgentExecutionStep[]
  events      AgentExecutionEvent[]
  snapshots   AgentExecutionSnapshot[]
  metrics     AgentExecutionMetric[]
  leases      AgentExecutionLease[]
  checkpoints AgentExecutionCheckpoint[]
  outbox      AgentExecutionOutbox[]
  inbox       AgentExecutionInbox[]
}

model AgentExecutionStep {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String         @db.Uuid
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  stepNumber Int
  type       String // LLM, Tool
  status     String

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  input  Json?
  output Json?
  error  String? @db.Text

  @@unique([executionId, stepNumber])
}

model AgentExecutionEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String         @db.Uuid
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  sequence      BigInt
  type          String // ExecutionStarted, LLMStarted, ToolRequested, etc.
  eventVersion  Int    @default(1)
  schemaVersion Int    @default(1)

  payload    Json
  occurredAt DateTime @default(now())

  @@unique([executionId, sequence])
}

model AgentExecutionSnapshot {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String         @db.Uuid
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  sequence  BigInt // Sequence number of the latest event included in this snapshot
  state     Json // Full snapshot of working memory, messages, context
  createdAt DateTime @default(now())
}

model AgentExecutionMetric {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String         @db.Uuid
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  name      String
  value     Float
  unit      String
  timestamp DateTime @default(now())
}

model AgentExecutionLease {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String         @unique @db.Uuid
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  ownerId   String // ID of the distributed worker holding the lease
  expiresAt DateTime
  version   Int      @default(1) // Optimistic concurrency for lease renewal
}

model AgentExecutionCheckpoint {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String         @db.Uuid
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  stepNumber       Int
  providerRequest  Json?
  providerResponse Json?
  usage            Json?
  finishReason     String?
  toolCalls        Json?

  createdAt DateTime @default(now())

  @@unique([executionId, stepNumber])
}

model AgentExecutionOutbox {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String         @db.Uuid
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  type        String
  payload     Json
  status      String    @default("PENDING") // PENDING, SENT, FAILED
  retries     Int       @default(0)
  nextRetryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentExecutionInbox {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  executionId String         @db.Uuid
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  eventId String @unique // External event ID to deduplicate
  type    String
  payload Json
  status  String @default("PROCESSED") // PROCESSED, FAILED

  createdAt DateTime @default(now())
}

model AgentConversation {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId String @db.Uuid
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  messages AgentMessage[]

  memory    Json? // Stores working memory and long-term memory context
  artifacts Json? // Stores generated artifacts (e.g. files, charts)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentMessage {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String            @db.Uuid
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String            @db.Text

  toolInvocations Json? // Stores tool calls (requests and results)
  metadata        Json? // Token usage, latency, etc.

  createdAt DateTime @default(now())
}

// -----------------------------------------------------------------------------
// PHASE 3: WORKFLOW DOMAIN
// -----------------------------------------------------------------------------

model WorkflowTemplate {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  definition Json
  workflows  Workflow[]
}

model Workflow {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String            @db.Uuid
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  templateId  String?           @db.Uuid
  template    WorkflowTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name       String
  versions   WorkflowVersion[]
  executions WorkflowExecution[]
  schedules  Schedule[]
  triggers   Trigger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowVersion {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId String   @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version    Int

  nodes WorkflowNode[]
  edges WorkflowEdge[]

  createdAt DateTime @default(now())

  @@unique([workflowId, version])
}

model WorkflowNode {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowVersionId String          @db.Uuid
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  name              String
  type              String
  config            Json?

  outgoingEdges  WorkflowEdge[]          @relation("SourceNode")
  incomingEdges  WorkflowEdge[]          @relation("TargetNode")
  stepExecutions WorkflowStepExecution[]
}

model WorkflowEdge {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowVersionId String          @db.Uuid
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  sourceNodeId      String          @db.Uuid
  sourceNode        WorkflowNode    @relation("SourceNode", fields: [sourceNodeId], references: [id])
  targetNodeId      String          @db.Uuid
  targetNode        WorkflowNode    @relation("TargetNode", fields: [targetNodeId], references: [id])
  condition         String?
}

model WorkflowExecution {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId         String    @db.Uuid
  workflow           Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status             String
  temporalWorkflowId String?
  output             Json?
  error              Json?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?

  runs WorkflowRun[]
}

model WorkflowRun {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowExecutionId String            @db.Uuid
  workflowExecution   WorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  status              String

  steps WorkflowStepExecution[]
}

model WorkflowStepExecution {
  id     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId  String       @db.Uuid
  run    WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId String       @db.Uuid
  node   WorkflowNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  logs        Json?
}

model Trigger {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId String   @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type       String
  config     Json
}

model Schedule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId String   @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  cron       String
  isActive   Boolean  @default(true)
}

model Event {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String
  payload   Json
  createdAt DateTime @default(now())
}

model Queue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  status    String
  payload   Json
  createdAt DateTime @default(now())
}

model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateId   String
  aggregateType String
  eventType     String
  payload       Json
  headers       Json      @default("{}")
  traceId       String?
  correlationId String?
  tenantId      String?   @db.Uuid
  partitionKey  String?
  schemaVersion String    @default("1.0")
  retryCount    Int       @default(0)
  status        String    @default("pending") // pending | published | failed
  error         String?   @db.Text
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([tenantId])
}

model IdempotencyRecord {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  workspaceId  String?   @db.Uuid
  operation    String
  requestHash  String
  responseHash String?
  status       String    @default("pending") // pending | completed | failed
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@unique([tenantId, requestHash])
  @@index([requestHash])
}

// -----------------------------------------------------------------------------
// PHASE 4: PROJECT & SOFTWARE ENGINEERING DOMAIN
// -----------------------------------------------------------------------------

// ForgePhase: idea → planning → architecture → design → implementation → testing → deployment → monitoring
// ForgeStatus: draft | active | paused | completed | failed

model Project {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?

  // CerebroForge fields
  prompt       String?  @db.Text // original natural-language build prompt
  forgeStatus  String   @default("draft") // draft | planning | architecting | designing | generating | testing | deploying | completed
  forgePhase   String   @default("idea") // idea | planning | architecture | design | implementation | testing | deployment
  stack        Json? // { frontend, backend, mobile, database, infra }
  frameworks   String[] @default([])
  actorList    String[] @default([])
  totalModules Int      @default(0)
  totalStories Int      @default(0)
  totalApis    Int      @default(0)
  planJson     Json? // full structured plan from AI Planner
  archJson     Json? // architecture decisions JSON
  designTokens Json? // color palette, typography, etc.
  repoOwner    String? // GitHub owner/org
  repoName     String? // GitHub repo name
  repoUrl      String?
  activeAgents String[] @default([])

  repositories  Repository[]
  sprints       Sprint[]
  milestones    Milestone[]
  modules       Module[]
  requirements  Requirement[]
  agentRuns     ForgeAgentRun[]
  artifacts     GeneratedArtifact[]
  forgeSessions ForgeSession[]
  archDecisions ArchitectureDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([forgeStatus])
}

model Repository {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String  @db.Uuid
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url           String
  provider      String  @default("github") // github | gitlab | bitbucket
  defaultBranch String  @default("main")

  branches Branch[]
  commits  Commit[]

  @@index([projectId])
}

model Branch {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String     @db.Uuid
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  name         String
  isDefault    Boolean    @default(false)
}

model Commit {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId String     @db.Uuid
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  hash         String
  message      String
  author       String
  agentType    String? // which agent made this commit
  createdAt    DateTime   @default(now())

  @@index([repositoryId])
}

model Module {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String  @db.Uuid
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String? @db.Text
  priority    String  @default("medium") // critical | high | medium | low
  storyCount  Int     @default(0)
  apiCount    Int     @default(0)
  status      String  @default("pending") // pending | generating | done

  features Feature[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Feature {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId           String  @db.Uuid
  module             Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name               String
  description        String? @db.Text
  acceptanceCriteria String? @db.Text
  status             String  @default("pending")
  tasks              Task[]

  @@index([moduleId])
}

model Task {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId      String?  @db.Uuid
  feature        Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)
  sprintId       String?  @db.Uuid
  sprint         Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  title          String
  status         String   @default("todo") // todo | in_progress | done
  agentType      String?
  estimatedHours Float?

  @@index([featureId])
}

model Sprint {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  tasks     Task[]

  @@index([projectId])
}

model Milestone {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String    @db.Uuid
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  weekLabel String? // e.g. "Week 1-2"
  order     Int       @default(0)

  @@index([projectId])
}

model Requirement {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String  @db.Uuid
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String // functional | non_functional | actor | entity | api_contract
  title       String
  description String? @db.Text
  priority    String  @default("medium")

  @@index([projectId])
  @@index([type])
}

model ArchitectureDecision {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  context   String  @db.Text
  decision  String  @db.Text
  status    String  @default("accepted") // proposed | accepted | deprecated | superseded
  pattern   String? // microservices | monolith | ddd | cqrs | event_driven | hexagonal
  techStack Json?

  @@index([projectId])
}

model GeneratedArtifact {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId  String   @db.Uuid
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String // file | test | migration | dockerfile | k8s_manifest | terraform | openapi
  filePath   String? // relative path in repo, e.g. "src/patients/patient.service.ts"
  language   String? // typescript | python | go | sql | yaml | hcl
  serviceId  String? // which microservice this belongs to
  content    String   @db.Text
  lineCount  Int      @default(0)
  status     String   @default("pending") // pending | generating | done | failed
  agentType  String? // which agent produced this
  commitHash String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, filePath])
  @@index([projectId])
  @@index([status])
  @@index([serviceId])
}

// Tracks every AI agent invocation within a forge project
model ForgeAgentRun {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String    @db.Uuid
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentType    String // pm | architect | ux | frontend | backend | mobile | desktop | chatbot | database | qa | security | devops | docs
  phase        String // which ForgePhase triggered this run
  status       String    @default("queued") // queued | running | completed | failed
  systemPrompt String    @db.Text
  userPrompt   String    @db.Text
  response     String?   @db.Text
  tokensIn     Int       @default(0)
  tokensOut    Int       @default(0)
  durationMs   Int?
  model        String? // which AI model was used
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([projectId])
  @@index([agentType])
  @@index([status])
}

// Active forge session — tracks SSE/WS connections
model ForgeSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?  @db.Uuid
  phase     String // current active phase
  isActive  Boolean  @default(true)
  clientId  String? // SSE/WS client identifier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isActive])
}

