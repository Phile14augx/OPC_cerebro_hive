  logoUrl      String?
  status       OrgStatus @default(ACTIVE)
  plan         PlanTier  @default(FREE)
  ownerId      String
  billingEmail String?
  taxId        String? // encrypted
  settings     Json      @default("{}")

  members       OrgMembership[]
  invitations   Invitation[]
  aiUsage       AIUsageRecord[]
  subscriptions Subscription[]
  invoices      Invoice[]
  usageBudgets  UsageBudget[]
  prompts       Prompt[]
  policies      Policy[]
}

model OrgMembership {
  userId   String   @db.Uuid
  orgId    String
  role     UserRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId, role])
  @@map("org_memberships")
}

model Invitation {
  id          String    @id @default(uuid())
  orgId       String
  email       String
  role        UserRole
  invitedById String    @db.Uuid
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([orgId, email])
  @@index([token])
  @@map("invitations")
}

model KnowledgeDocument {
  id           String         @id @default(dbgenerated("('doc_' || replace(uuid_generate_v4()::text, '-', ''))"))
  collectionId String
  orgId        String
  title        String
  sourceUrl    String?
  sourceType   String
  mimeType     String?
  contentHash  String
  charCount    Int            @default(0)
  chunkCount   Int            @default(0)
  status       DocumentStatus @default(PENDING)
  error        String?
  metadata     Json           @default("{}")
}

model AIUsageRecord {
  id           String   @id @default(uuid())
  orgId        String
  workflowId   String?
  executionId  String?
  agentId      String?
  userId       String?
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  costUsd      Decimal  @db.Decimal(12, 6)
  durationMs   Int
  ttftMs       Int?
  cached       Boolean  @default(false)
  streamed     Boolean  @default(false)
  error        String?
  finishReason String?
  requestId    String
  traceId      String?
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, provider, model])
  @@index([executionId])
  @@map("ai_usage_records")
}

model Subscription {
  id                   String             @id @default(uuid())
  orgId                String
  stripeSubscriptionId String             @unique
  plan                 String
  status               SubscriptionStatus
  interval             String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  seats                Int                @default(1)
  addons               Json               @default("[]")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([orgId, status])
  @@map("subscriptions")
}

model Invoice {
  id              String        @id @default(uuid())
  orgId           String
  subscriptionId  String?
  stripeInvoiceId String        @unique
  status          InvoiceStatus
  amount          Int // cents
  currency        String        @default("usd")
  tax             Int           @default(0)
  periodStart     DateTime
  periodEnd       DateTime
  paidAt          DateTime?
  invoiceUrl      String?
  pdfUrl          String?
  lineItems       Json          @default("[]")
  createdAt       DateTime      @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([orgId, status])
  @@map("invoices")
}

model UsageBudget {
  orgId           String   @id
  monthlyCapUsd   Decimal  @db.Decimal(10, 2)
  alertThreshold  Decimal  @default(0.8) @db.Decimal(4, 3)
  alertEmail      String
  hardCap         Boolean  @default(false)
  currentSpendUsd Decimal  @default(0) @db.Decimal(12, 6)
  periodStart     DateTime
  periodEnd       DateTime
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("usage_budgets")
}

model Prompt {
  id            String   @id @default(uuid())
  orgId         String
  name          String
  slug          String
  description   String   @default("")
  status        String   @default("DRAFT") // DRAFT | PUBLISHED | DEPRECATED
  category      String   @default("general")
  tags          String[] @default([])
  activeVersion Int      @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  versions PromptVersion[]
  evalRuns EvalRun[]

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@index([orgId, category])
  @@map("prompts")
}

model PromptVersion {
  id          String   @id @default(uuid())
  promptId    String
  orgId       String
  version     Int
  content     String // rendered template string
  model       String
  variables   String[] @default([])
  description String   @default("")
  changelog   String   @default("")
  contentHash String
  tags        String[] @default([])
  isActive    Boolean  @default(false)
  createdBy   String?
  metrics     Json? // { successRate, avgTokens, avgLatencyMs, runs }

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
}

model EvalDataset {
  id          String @id @default(uuid())
  orgId       String
  name        String
  description String @default("")
  rowCount    Int    @default(0)
  schema      Json   @default("{}")
}

model EvalRun {
  id         String  @id @default(uuid())
  orgId      String
  name       String
  promptId   String?
  promptSlug String  @default("")
  datasetId  String?
  model      String
  status     String  @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  samples    Int     @default(0)
  passed     Int     @default(0)
  metrics    Json    @default("{}")

  prompt Prompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
}

model ModelEntry {
  id               String   @id @default(cuid())
  orgId            String?
  modelId          String   @unique // canonical model identifier (e.g. "claude-sonnet-5")
  displayName      String
  provider         String
  description      String   @default("")
  contextWindow    Int      @default(0)
  maxOutput        Int      @default(0)
  inputPricePer1M  Decimal  @default(0) @db.Decimal(10, 4)
  outputPricePer1M Decimal  @default(0) @db.Decimal(10, 4)
  capabilities     String[] @default([]) // vision | function_call | streaming | json_mode | reasoning
  status           String   @default("ACTIVE") // ACTIVE | DEPRECATED | INACTIVE
  metadata         Json     @default("{}")
}

// -----------------------------------------------------------------------------
// PHASE 5: CEREBROARCHIVE (KNOWLEDGE REPOSITORY)
// -----------------------------------------------------------------------------

model ArchiveDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  title            String
  description      String?   @db.Text
  documentType     String
  currentVersionId String?   @db.Uuid
  ownerId          String?   @db.Uuid
  visibility       String    @default("PRIVATE")
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  versions ArchiveDocumentVersion[]
  tags     ArchiveDocumentTag[]
  acls     ArchiveDocumentAcl[]

  @@index([tenantId])
}

model ArchiveDocumentVersion {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId       String          @db.Uuid
  document         ArchiveDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int             @default(1)
  storageKey       String
  originalFilename String
  mimeType         String
  byteSize         BigInt
  checksumSha256   String
  processingStatus String          @default("CREATED")
  language         String          @default("en")
  pageCount        Int             @default(0)
  wordCount        Int             @default(0)
  createdBy        String?         @db.Uuid
  createdAt        DateTime        @default(now())
  processedAt      DateTime?

  chunks ArchiveDocumentChunk[]
  runs   ArchiveProcessingRun[]

  @@unique([documentId, versionNumber])
}

model ArchiveDocumentChunk {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String                 @db.Uuid
  documentId      String                 @db.Uuid
  versionId       String                 @db.Uuid
  version         ArchiveDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunkIndex      Int
  text            String                 @db.Text
  tokenCount      Int                    @default(0)
  pageStart       Int?
  pageEnd         Int?
  sectionPath     Json?
  contentHash     String
  embeddingStatus String                 @default("PENDING")
  createdAt       DateTime               @default(now())

  entities ArchiveChunkEntity[]

  @@index([versionId])
  @@index([contentHash])
}

model ArchiveEntity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  canonicalName String
  entityType    String
  description   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  chunks ArchiveChunkEntity[]

  @@unique([tenantId, canonicalName, entityType])
}

model ArchiveChunkEntity {
  chunkId    String               @db.Uuid
  entityId   String               @db.Uuid
  chunk      ArchiveDocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  entity     ArchiveEntity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  confidence Float                @default(1.0)
  source     String               @default("EXTRACTED")

  @@id([chunkId, entityId])
}

model ArchiveTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  slug      String
  type      String   @default("AUTO")
  createdAt DateTime @default(now())

  documents ArchiveDocumentTag[]

  @@unique([tenantId, slug])
}

model ArchiveDocumentTag {
  documentId String          @db.Uuid
  tagId      String          @db.Uuid
  document   ArchiveDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        ArchiveTag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  confidence Float           @default(1.0)
  source     String          @default("AUTO")
  approvedBy String?         @db.Uuid

  @@id([documentId, tagId])
}

model ArchiveDocumentAcl {
  documentId    String          @db.Uuid
  document      ArchiveDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  principalType String
  principalId   String
  permission    String
  createdAt     DateTime        @default(now())

  @@id([documentId, principalType, principalId])
}

model ArchiveProcessingRun {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId       String                 @db.Uuid
  version         ArchiveDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  pipelineVersion String
  status          String                 @default("QUEUED")
  currentStage    String                 @default("CREATED")
  startedAt       DateTime               @default(now())
  completedAt     DateTime?
  errorCode       String?
  errorMessage    String?                @db.Text
  retryCount      Int                    @default(0)
  traceId         String?

  events ArchiveProcessingEvent[]
}

model ArchiveProcessingEvent {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String               @db.Uuid
  run       ArchiveProcessingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage     String
  status    String
  details   Json?
  createdAt DateTime             @default(now())
}

model ArchiveSearchQuery {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  userId      String?  @db.Uuid
  queryHash   String
  mode        String   @default("HYBRID")
  filters     Json?
  resultCount Int      @default(0)
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}
