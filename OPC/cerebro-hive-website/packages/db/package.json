{
  "name": "@cerebro/db",
  "version": "1.0.0",
  "private": true,
  "main": "dist/db/index.js",
  "types": "dist/db/index.d.ts",
  "scripts": {
    "build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/generated/client','dist/db/src/generated/client',{recursive:true})\"",
    "generate": "prisma generate",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "push": "prisma db push",
    "migrate:dev": "prisma migrate dev",
    "studio": "prisma studio",
    "lint": "eslint \"**/*.ts*\"",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@cerebro/twin-contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@prisma/client-runtime-utils": "^7.9.0",
    "@prisma/config": "^7.9.0",
    "pg": "^8.22.0",
    "@cerebro/runtime-core": "workspace:*",
    "@cerebro/runtime-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prisma": "^7.9.0",
    "tsx": "^4.7.1",
    "typescript": "^5.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
