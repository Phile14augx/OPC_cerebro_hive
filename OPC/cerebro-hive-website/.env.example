# ==============================================================================
# CEREBROHIVE PLATFORM CORE ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE & CACHE
# ------------------------------------------------------------------------------
# Connection string for the PostgreSQL Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://cerebrohive:supersecretpassword123@localhost:5432/cerebrohive_db?schema=public"

# Connection string for Redis cache & job queues
REDIS_URL="redis://:redispassword123@localhost:6379"

# ------------------------------------------------------------------------------
# AUTHENTICATION
# ------------------------------------------------------------------------------
# NextAuth / Auth.js Secret (Run `openssl rand -base64 32` to generate)
NEXTAUTH_SECRET="development_secret_do_not_use_in_production"
NEXTAUTH_URL="http://localhost:3400"

# ------------------------------------------------------------------------------
# AI PROVIDERS
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# CEREBROFORGE™ AI SOFTWARE FACTORY
# ------------------------------------------------------------------------------
# Which AI provider to use for forge agents: anthropic | openai | mock
AI_PROVIDER="anthropic"
# Model to use (anthropic: claude-sonnet-4-6, openai: gpt-4o)
AI_MODEL_ID="claude-sonnet-4-6"
# Port for the forge-api NestJS service
FORGE_API_PORT=4005
# Public URL for the studio UI to reach forge-api
NEXT_PUBLIC_FORGE_API_URL="http://localhost:4005"
# Optional: pin a specific workspace UUID — if blank, forge-api auto-provisions one
FORGE_DEFAULT_WORKSPACE_ID=""

# ------------------------------------------------------------------------------
# NEW BACKEND SERVICES (Rust Gateway + Java + C++ ML)
# ------------------------------------------------------------------------------

# Keycloak OIDC (identity provider for all services)
KEYCLOAK_URL="http://localhost:8080"
# JWT verification in @cerebro/auth reads KEYCLOAK_SERVER_URL, not KEYCLOAK_URL.
KEYCLOAK_SERVER_URL="http://localhost:8080"
KEYCLOAK_REALM="cerebro"
KEYCLOAK_CLIENT_ID="cerebro-gateway"

# Rust API Gateway
GATEWAY_HOST="0.0.0.0"
GATEWAY_PORT=8900
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
ALLOWED_ORIGINS="http://localhost:3400"

# Java service internal URLs (used by gateway)
PLATFORM_SVC_URL="http://localhost:8081"
ACADEMY_SVC_URL="http://localhost:8082"
CRM_SVC_URL="http://localhost:8083"
ML_SVC_GRPC_URL="http://localhost:50051"

# C++ ML gRPC service
GRPC_ADDR="0.0.0.0:50051"
LOG_LEVEL="info"

# Next.js marketing site — public env vars
NEXT_PUBLIC_SITE_URL="http://localhost:3400"
# Marketing/gateway default. Studio's api-client strips a trailing /api/v1 so
# both this value and a bare http://localhost:3406 (platform-api) work.
# Point Studio at platform-api when the Rust gateway is not running:
# NEXT_PUBLIC_API_URL="http://localhost:3406"
NEXT_PUBLIC_API_URL="http://localhost:8900/api/v1"
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8080"
NEXT_PUBLIC_KEYCLOAK_REALM="cerebro"
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID="cerebro-web"

# ── Platform API, consumed by the live /platform/* product pages ──────────────
# Read by lib/platform-api.ts.
#
# Set this to a SAME-ORIGIN path (e.g. "/api/v1") wherever the site runs with a
# server in front of it. When the value starts with "/", the client attaches no
# Authorization header at all and the origin supplies the real credential —
# nothing secret reaches the browser.
NEXT_PUBLIC_PLATFORM_API_URL="http://localhost:8090"

# WARNING: anything prefixed NEXT_PUBLIC_ is inlined into the JavaScript bundle
# and is publicly readable by anyone who loads the site. This variable exists
# only to make the STATIC_EXPORT build (GitHub Pages — no server, so no way to
# proxy) able to reach a demo backend.
#
# It MUST be a scoped, read-only, rate-limited demo credential.
# It MUST NOT be a tenant, admin, or service key.
# Leave it EMPTY in any deployment that fronts the API with a server.
NEXT_PUBLIC_PLATFORM_DEMO_KEY=""

# Internal server-side API URL (server components → gateway bypass public DNS)
API_URL="http://localhost:8900/api/v1"

# Set to "true" for GitHub Pages / Netlify static export (disables SSR)
# STATIC_EXPORT="true"

# ------------------------------------------------------------------------------
# HIVESWARM SERVICES (Go)
# ------------------------------------------------------------------------------

# swarm-api (Go HTTP + WebSocket)
SWARM_API_URL="http://localhost:8910"
SWARM_API_PORT=8910

# swarm-runtime (Go Temporal worker + NATS consumer)
TEMPORAL_HOST="localhost:7233"
WORKER_CONCURRENCY=20

# Internal reference from swarm-runtime → swarm-api
# (used for agent lookup during task dispatch)
SWARM_API_INTERNAL_URL="http://swarm-api:8910"

# ------------------------------------------------------------------------------
# HIVESWARM M2: INTELLIGENCE LAYER
# ------------------------------------------------------------------------------

# learning-service (Python — replay storage, benchmarks, prompt optimisation)
LEARNING_SERVICE_URL="http://localhost:8950"
LEARNING_SERVICE_PORT=8950

# tool-gateway (Go — tool registry + execution proxy)
TOOL_GATEWAY_URL="http://localhost:8940"
TOOL_GATEWAY_PORT=8940

# Tool credentials (leave blank to use stub/offline mode)
GITHUB_TOKEN=""
SLACK_BOT_TOKEN=""
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_KEY=""
SERPER_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# memory-service (Go — four-tier agent memory)
MEMORY_SERVICE_URL="http://localhost:8930"
MEMORY_SERVICE_PORT=8930

# planner-service (Python + LangGraph)
PLANNER_SERVICE_URL="http://localhost:8920"
PLANNER_SERVICE_PORT=8920

# router-service (Go)
ROUTER_SERVICE_URL="http://localhost:8921"
ROUTER_SERVICE_PORT=8921

# evaluation-service (Python)
EVALUATION_SERVICE_URL="http://localhost:8922"
EVALUATION_SERVICE_PORT=8922

# ------------------------------------------------------------------------------
# HIVESWARM AGENT RUNNER (Python)
# ------------------------------------------------------------------------------

# agent-runner (Python FastAPI — hosts Orchestrator, Critic, Coder, Research)
AGENT_RUNNER_URL="http://localhost:8960"
AGENT_RUNNER_PORT=8960

# Self-reported endpoint (must be reachable by swarm-runtime workers inside Docker)
AGENT_RUNNER_ENDPOINT="http://agent-runner:8960"

# LLM backend: "anthropic" | "mock"
# Use "mock" for offline/dev mode (no API key required)
# AI_PROVIDER is already set above — agent-runner inherits it

# Per-agent model overrides (all default to claude-sonnet-4-6)
ORCHESTRATOR_MODEL="claude-sonnet-4-6"
CRITIC_MODEL="claude-sonnet-4-6"
CODING_MODEL="claude-sonnet-4-6"
RESEARCH_MODEL="claude-sonnet-4-6"

# ------------------------------------------------------------------------------
# CEREBROCYBER™ SECURITY SUITE
# ------------------------------------------------------------------------------

# CerebroCyber API secret for internal service authentication
CYBER_API_SECRET=""

# Threat intelligence feed configuration
THREAT_INTEL_FEEDS="alienvault,virustotal,abusech,misp"
THREAT_INTEL_REFRESH_INTERVAL=3600

# DLP configuration
PII_DETECTION_ENABLED=true
CREDENTIAL_DETECTION_ENABLED=true
NETWORK_SEGMENTATION_ENABLED=true

# Security event storage
SECURITY_EVENTS_ENABLED=true
SECURITY_EVENTS_MAX_AGE_DAYS=90

# Compliance framework settings
COMPLIANCE_FRAMEWORKS="soc2,hipaa,gdpr,iso27001"
EVIDENCE_COLLECTION_ENABLED=true

# Security logging
SECURITY_LOG_LEVEL="info"
SECURITY_AUDIT_ENABLED=true

# Rate limiting for security endpoints
SECURITY_RATE_LIMIT=100
SECURITY_RATE_WINDOW=60000

# AI-specific threat detection
PROMPT_INJECTION_DETECTION=true
DLP_SEMANTIC_SCAN=true
AGENT_BEHAVIORAL_MONITORING=true
