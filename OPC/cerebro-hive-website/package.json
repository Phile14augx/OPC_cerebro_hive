{
  "name": "cerebro-hive-os",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:integration": "dotenv -e .env.test -- vitest run --config tests/integration/vitest.config.ts",
    "test:integration:watch": "dotenv -e .env.test -- vitest --config tests/integration/vitest.config.ts",
    "test:e2e": "turbo test:e2e",
    "test:coverage": "turbo test -- --coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\" --ignore-path .prettierignore",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -not -path './.git/*' | xargs rm -rf",
    "clean:build": "turbo clean",
    "validate:architecture": "depcruise --config .dependency-cruiser.js packages apps",
    "prisma:generate": "turbo prisma:generate",
    "prisma:migrate": "turbo prisma:migrate:deploy",
    "release": "semantic-release",
    "policy:check": "turbo policy:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^55.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{js,jsx,json,md,yaml,yml}": ["prettier --write"],
    "*.{tf,tfvars}": ["terraform fmt -"],
    "*.rego": ["opa fmt -w"]
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"],
    "rules": {
      "type-enum": [2, "always", [
        "feat", "fix", "docs", "style", "refactor", "perf",
        "test", "build", "ci", "chore", "revert", "infra", "security"
      ]],
      "scope-enum": [1, "always", [
        "studio", "forge", "platform-api", "forge-api", "ai-gateway",
        "telemetry", "db", "auth", "queue", "config", "shared-types",
        "llmops", "agent-ops", "knowledge-ops",
        "k8s", "helm", "terraform", "argocd", "ci", "deps", "release"
      ]],
      "body-max-line-length": [1, "always", 200]
    }
  }
}
