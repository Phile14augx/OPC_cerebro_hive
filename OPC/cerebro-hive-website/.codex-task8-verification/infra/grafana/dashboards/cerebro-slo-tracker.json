{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "description": "SLO tracking — error budget consumption, burn rates, availability and latency SLIs",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "icon": "external link", "title": "Platform Overview", "url": "/d/cerebro-overview", "type": "link" },
    { "icon": "external link", "title": "AI Costs", "url": "/d/cerebro-ai-costs", "type": "link" }
  ],
  "panels": [
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100, "title": "Error Budget Status", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "green", "value": 0.5 }] },
          "mappings": []
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "id": 1, "title": "Availability Error Budget Remaining",
      "description": "SLO: 99.9% availability. Budget = 0.1% of request volume per 30 days.",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area"
      },
      "type": "stat",
      "targets": [{
        "expr": "1 - (cerebro:slo:availability:error_budget_consumed:rate30d / cerebro:slo:availability:error_budget_total:rate30d)",
        "legendFormat": "Budget Remaining"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "green", "value": 0.5 }] }
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "id": 2, "title": "Latency Error Budget Remaining",
      "description": "SLO: 95% of requests <500ms. Budget = 5% of request volume per 30 days.",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "type": "stat",
      "targets": [{
        "expr": "1 - (cerebro:slo:latency:error_budget_consumed:rate30d / cerebro:slo:latency:error_budget_total:rate30d)",
        "legendFormat": "Budget Remaining"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.99 }, { "color": "red", "value": 0.995 }] }
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "id": 3, "title": "30-Day Availability",
      "description": "Target: 99.9%",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "type": "stat",
      "targets": [{
        "expr": "cerebro:slo:availability:rate30d",
        "legendFormat": "Availability"
      }]
    },
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101, "title": "Burn Rate (Multi-Window Alert Model)", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "1h burn rate" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "6h burn rate" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "24h burn rate" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 },
      "id": 10, "title": "Error Budget Burn Rate (target: ≤1x)",
      "description": "Values >14.4x trigger a critical page. Values >6x over 6h trigger a warning.",
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "type": "timeseries",
      "targets": [
        { "expr": "cerebro:slo:availability:burn_rate_1h",  "legendFormat": "1h burn rate" },
        { "expr": "cerebro:slo:availability:burn_rate_6h",  "legendFormat": "6h burn rate" },
        { "expr": "cerebro:slo:availability:burn_rate_1d",  "legendFormat": "24h burn rate" },
        { "expr": "cerebro:slo:availability:burn_rate_3d",  "legendFormat": "3d burn rate" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" },
        "overrides": []
      }
    },
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102, "title": "SLI Details — Availability & Latency", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 20, "title": "Availability SLI by Service",
      "description": "SLO target line at 99.9%",
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"] }
      },
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{namespace=~\"cerebro-.*\",status!~\"5..\"}[$__rate_interval])) / sum by (service) (rate(http_requests_total{namespace=~\"cerebro-.*\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        },
        {
          "expr": "vector(0.999)",
          "legendFormat": "SLO Target (99.9%)"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 21, "title": "Latency SLI — p99 vs Target",
      "description": "SLO target: p99 < 500ms",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=~\"cerebro-.*\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p99 — {{service}}"
        },
        {
          "expr": "vector(0.5)",
          "legendFormat": "SLO Target (500ms)"
        }
      ]
    },
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103, "title": "Error Budget Consumption Over Time", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "min": 0, "max": 1, "custom": { "fillOpacity": 20 } }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "id": 30, "title": "Error Budget Consumed (cumulative, 30-day window)",
      "description": "Ideally this line stays below 100% throughout the month.",
      "type": "timeseries",
      "targets": [
        {
          "expr": "cerebro:slo:availability:error_budget_consumed:rate30d / cerebro:slo:availability:error_budget_total:rate30d",
          "legendFormat": "Availability Budget Consumed"
        },
        {
          "expr": "cerebro:slo:latency:error_budget_consumed:rate30d / cerebro:slo:latency:error_budget_total:rate30d",
          "legendFormat": "Latency Budget Consumed"
        },
        {
          "expr": "vector(1.0)",
          "legendFormat": "Budget Limit (100%)"
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["cerebro-hive", "slo", "reliability", "sre"],
  "templating": {
    "list": [
      {
        "current": { "text": "30d", "value": "30d" },
        "hide": 0, "name": "window", "label": "Window",
        "options": [
          { "selected": true, "text": "7d",  "value": "7d"  },
          { "selected": false, "text": "14d", "value": "14d" },
          { "selected": false, "text": "30d", "value": "30d" }
        ],
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CerebroHive — SLO Tracker",
  "uid":   "cerebro-slo",
  "version": 1
}
