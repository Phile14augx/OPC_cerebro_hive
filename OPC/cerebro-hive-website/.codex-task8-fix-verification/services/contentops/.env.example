# ─────────────────────────────────────────────
# CerebroContent — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Anthropic (required for AI transformation)
# Get from: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# LinkedIn (required to publish to LinkedIn)
# Do NOT fill these in manually — run: pnpm auth:linkedin
# The OAuth flow will populate all three automatically.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_TOKEN_EXPIRES_AT=
LINKEDIN_PERSON_URN=

# Medium (required to publish to Medium)
# Get from: https://medium.com/me/settings → Integration tokens
MEDIUM_INTEGRATION_TOKEN=

# Pipeline settings
# Set to "true" to test without actually posting anything
DRY_RUN=false

# Folder to watch (Windows path, forward slashes ok)
# Default: C:/Claude/Scheduled
WATCH_DIR=C:/Claude/Scheduled

# Log level: error | warn | info | debug
LOG_LEVEL=info
