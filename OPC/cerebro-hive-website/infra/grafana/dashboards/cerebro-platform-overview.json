{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" },
    { "name": "DS_LOKI",       "label": "Loki",       "type": "datasource", "pluginId": "loki" },
    { "name": "DS_TEMPO",      "label": "Tempo",      "type": "datasource", "pluginId": "tempo" }
  ],
  "__requires": [
    { "type": "grafana",    "id": "grafana",    "name": "Grafana",    "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" },
    { "type": "datasource", "id": "tempo",      "name": "Tempo",      "version": "1.0.0" },
    { "type": "panel",      "id": "timeseries", "name": "Time series","version": "" },
    { "type": "panel",      "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel",      "id": "gauge",      "name": "Gauge",      "version": "" },
    { "type": "panel",      "id": "table",      "name": "Table",      "version": "" },
    { "type": "panel",      "id": "logs",       "name": "Logs",       "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true, "hide": true, "iconColor": "rgba(0,211,255,1)",
        "name": "Annotations & Alerts", "type": "dashboard"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": true, "expr": "changes(kube_deployment_status_replicas_updated{namespace=~\"cerebro-.*\"}[1m]) > 0",
        "hide": false, "iconColor": "blue", "name": "Deployments", "step": "60s", "titleFormat": "Deploy: {{deployment}}"
      }
    ]
  },
  "description": "CerebroHive Platform Overview — Request rate, error rate, latency, pod health, and log stream",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "icon": "external link", "title": "AI Costs", "url": "/d/cerebro-ai-costs", "type": "link" },
    { "icon": "external link", "title": "SLO Tracker", "url": "/d/cerebro-slo", "type": "link" }
  ],
  "panels": [
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100, "title": "Service Health", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }
          ]},
          "unit": "percentunit", "min": 0, "max": 1,
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1, "title": "Availability (30d)",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "cerebro:slo:availability:rate30d",
        "legendFormat": "Availability"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "red", "value": 0.5 }
          ]},
          "unit": "percentunit", "min": 0, "max": 1
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2, "title": "Error Rate (5m)",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none" },
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "cerebro:slo:error_rate:rate5m",
        "legendFormat": "Error Rate"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1.0 }
          ]},
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3, "title": "p99 Latency",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=~\"cerebro-.*\"}[5m])) by (le))",
        "legendFormat": "p99"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4, "title": "Request Rate",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "sum(rate(http_requests_total{namespace=~\"cerebro-.*\"}[5m]))",
        "legendFormat": "RPS"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5, "title": "Pods Not Ready",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "count(kube_pod_status_ready{namespace=~\"cerebro-.*\",condition=\"false\"} == 1) or vector(0)",
        "legendFormat": "Unhealthy Pods"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6, "title": "Active Alerts",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "type": "stat",
      "targets": [{
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "expr": "count(ALERTS{alertstate=\"firing\",namespace=~\"cerebro-.*\"}) or vector(0)",
        "legendFormat": "Firing Alerts"
      }]
    },
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101, "title": "Request Rate & Error Rate", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "Error.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10, "title": "HTTP Request Rate by Service",
      "options": { "tooltip": { "mode": "multi", "sort": "desc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } },
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (service) (rate(http_requests_total{namespace=~\"cerebro-.*\",status!~\"5..\"}[5m]))",
          "legendFormat": "{{service}} — 2xx"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (service) (rate(http_requests_total{namespace=~\"cerebro-.*\",status=~\"5..\"}[5m]))",
          "legendFormat": "Error — {{service}}"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "custom": { "fillOpacity": 10 } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11, "title": "Latency Percentiles (p50 / p95 / p99)",
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } },
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{namespace=~\"cerebro-.*\"}[5m])) by (le, service))",
          "legendFormat": "p50 — {{service}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{namespace=~\"cerebro-.*\"}[5m])) by (le, service))",
          "legendFormat": "p95 — {{service}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=~\"cerebro-.*\"}[5m])) by (le, service))",
          "legendFormat": "p99 — {{service}}"
        }
      ]
    },
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102, "title": "AI Gateway — Token Usage", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 15 },
      "id": 20, "title": "Token Usage Rate by Provider",
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] } },
      "type": "timeseries",
      "targets": [{
        "expr": "sum by (provider) (rate(ai_gateway_tokens_total{namespace=~\"cerebro-.*\"}[5m])) * 60",
        "legendFormat": "{{provider}}"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s", "custom": { "fillOpacity": 5 } } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 15 },
      "id": 21, "title": "AI Inference Latency p95 by Model",
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] } },
      "type": "timeseries",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(ai_gateway_inference_duration_seconds_bucket{namespace=~\"cerebro-.*\"}[5m])) by (le, model))",
        "legendFormat": "p95 — {{model}}"
      }]
    },
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 103, "title": "Infrastructure — Pods & Resources", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "percentunit", "max": 1 } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "id": 30, "title": "CPU Utilisation by Deployment",
      "type": "timeseries",
      "targets": [{
        "expr": "sum by (deployment) (rate(container_cpu_usage_seconds_total{namespace=~\"cerebro-.*\",container!=\"\"}[5m])) / sum by (deployment) (kube_deployment_spec_replicas{namespace=~\"cerebro-.*\"})",
        "legendFormat": "{{deployment}}"
      }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "bytes" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
      "id": 31, "title": "Memory Usage by Deployment",
      "type": "timeseries",
      "targets": [{
        "expr": "sum by (deployment) (container_memory_working_set_bytes{namespace=~\"cerebro-.*\",container!=\"\"})",
        "legendFormat": "{{deployment}}"
      }]
    },
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 104, "title": "Logs", "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 31 },
      "id": 40, "title": "Error Logs (all services)",
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "type": "logs",
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "{namespace=~\"cerebro-.*\"} |= \"error\" | json | level =~ \"error|fatal\" | line_format \"{{.level}} [{{.service}}] {{.message}}\""
      }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["cerebro-hive", "platform", "overview"],
  "templating": {
    "list": [
      {
        "current": {}, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(kube_pod_info{namespace=~\"cerebro-.*\"}, namespace)",
        "hide": 0, "includeAll": true, "multi": true, "name": "namespace",
        "options": [], "query": { "query": "label_values(kube_pod_info{namespace=~\"cerebro-.*\"}, namespace)", "refId": "prometheus" },
        "refresh": 2, "sort": 1, "type": "query", "label": "Namespace"
      },
      {
        "current": {}, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(http_requests_total{namespace=~\"$namespace\"}, service)",
        "hide": 0, "includeAll": true, "multi": true, "name": "service",
        "options": [], "query": { "query": "label_values(http_requests_total{namespace=~\"$namespace\"}, service)", "refId": "prometheus" },
        "refresh": 2, "sort": 1, "type": "query", "label": "Service"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CerebroHive — Platform Overview",
  "uid":   "cerebro-overview",
  "version": 1
}
