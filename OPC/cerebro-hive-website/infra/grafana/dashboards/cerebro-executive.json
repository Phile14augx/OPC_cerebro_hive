{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus" }
  ],
  "description": "Executive view — platform health, AI spend, customer activity, SLO attainment, and capacity at a glance",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [
    { "icon": "external link", "title": "Platform Detail", "url": "/d/cerebro-overview", "type": "link" },
    { "icon": "external link", "title": "AI Costs",        "url": "/d/cerebro-ai-costs", "type": "link" },
    { "icon": "external link", "title": "SLO Tracker",     "url": "/d/cerebro-slo",      "type": "link" }
  ],
  "panels": [
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100, "title": "Platform Health", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "percentunit", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.995 }, { "color": "green", "value": 0.999 }
          ]},
          "min": 0.99, "max": 1
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "id": 1, "title": "Platform Availability (30d)",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "type": "stat",
      "targets": [{ "expr": "cerebro:slo:availability:rate30d", "legendFormat": "Availability" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "currencyUSD",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 3500 }, { "color": "red", "value": 4500 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "id": 2, "title": "AI Spend — This Month",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "type": "stat",
      "targets": [{ "expr": "cerebro:ai:cost_usd:month", "legendFormat": "Month" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "id": 3, "title": "Active Workspaces (24h)",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "type": "stat",
      "targets": [{ "expr": "cerebro:business:active_orgs_1d", "legendFormat": "Workspaces" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] }
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "id": 4, "title": "Inference Requests (24h)",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "type": "stat",
      "targets": [{ "expr": "sum(increase(llm_requests_total{namespace=~\"cerebro-.*\"}[24h]))", "legendFormat": "Inferences" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "id": 5, "title": "Active Incidents",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "type": "stat",
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\",namespace=~\"cerebro-.*\"}) or vector(0)", "legendFormat": "Critical Alerts" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "percentunit", "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 0.75 }, { "color": "red", "value": 0.9 }
          ]}
        }
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "id": 6, "title": "AI Budget Used",
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "type": "stat",
      "targets": [{ "expr": "cerebro:ai:cost_usd:month / cerebro:ai:cost_budget_usd:month", "legendFormat": "% Budget" }]
    },

    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101, "title": "Request Volume & Availability Trend", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps", "custom": { "fillOpacity": 10 } }
      },
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 7 },
      "id": 10, "title": "Total Request Volume",
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(http_requests_total{namespace=~\"cerebro-.*\"}[5m]))", "legendFormat": "Requests/s" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "percentunit",
          "min": 0.99, "max": 1,
          "custom": { "fillOpacity": 20 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.995 }, { "color": "green", "value": 0.999 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 7 },
      "id": 11, "title": "Platform Availability",
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "type": "timeseries",
      "targets": [
        { "expr": "cerebro:slo:availability:rate30d", "legendFormat": "30d Availability" },
        { "expr": "vector(0.999)", "legendFormat": "SLO Target (99.9%)" }
      ]
    },

    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102, "title": "AI Spend & Inference Volume", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "currencyUSD", "custom": { "fillOpacity": 15 } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 20, "title": "Daily AI Spend by Provider",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (provider) (rate(llm_cost_usd_total{namespace=~\"cerebro-.*\"}[1h])) * 3600 * 24", "legendFormat": "{{provider}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 21, "title": "Inference Volume by Model",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (gen_ai_request_model) (rate(llm_requests_total{namespace=~\"cerebro-.*\"}[1h])) * 3600", "legendFormat": "{{gen_ai_request_model}}" }
      ]
    },

    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103, "title": "SLO Attainment & Capacity", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null }, { "color": "yellow", "value": 0.25 }, { "color": "green", "value": 0.5 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 25 },
      "id": 30, "title": "Error Budget Remaining",
      "description": "Green = healthy budget. Red = budget nearly exhausted.",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "showThresholdLabels": true, "showThresholdMarkers": true
      },
      "type": "gauge",
      "targets": [
        { "expr": "1 - (cerebro:slo:availability:error_budget_consumed:rate30d / cerebro:slo:availability:error_budget_total:rate30d)", "legendFormat": "Availability" },
        { "expr": "1 - (cerebro:slo:latency:error_budget_consumed:rate30d / cerebro:slo:latency:error_budget_total:rate30d)", "legendFormat": "Latency" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.85 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 25 },
      "id": 31, "title": "Cluster Capacity (CPU p95)",
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal",
        "showThresholdLabels": true, "showThresholdMarkers": true
      },
      "type": "gauge",
      "targets": [
        { "expr": "quantile(0.95, cerebro:k8s:pod_cpu_utilization)", "legendFormat": "CPU p95" },
        { "expr": "quantile(0.95, cerebro:k8s:pod_memory_utilization)", "legendFormat": "Memory p95" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Workspace" }, "properties": [{ "id": "custom.width", "value": 200 }] },
          { "matcher": { "id": "byName", "options": "Inferences (24h)" }, "properties": [{ "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } }] },
          { "matcher": { "id": "byName", "options": "Cost (Month $)" }, "properties": [{ "id": "unit", "value": "currencyUSD" }, { "id": "custom.displayMode", "value": "color-background" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 }] } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 25 },
      "id": 32, "title": "Top Workspaces",
      "type": "table",
      "transformations": [{ "id": "sortBy", "options": { "fields": [{ "desc": true, "displayName": "Cost (Month $)" }] } }],
      "targets": [{
        "expr": "topk(8, sum by (workspace_id) (llm_cost_usd_total{namespace=~\"cerebro-.*\",range=\"month\"}))",
        "legendFormat": "{{workspace_id}}", "instant": true, "format": "table"
      }]
    },

    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 104, "title": "Agent Performance", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short", "custom": { "fillOpacity": 5 } }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 34 },
      "id": 40, "title": "Agent Run Rate by Type",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (cerebro_agent_type) (rate(agent_runs_total{namespace=~\"cerebro-.*\"}[5m])) * 60", "legendFormat": "{{cerebro_agent_type}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 34 },
      "id": 41, "title": "Agent p95 Duration by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (cerebro_agent_type, le) (rate(agent_run_duration_seconds_bucket{namespace=~\"cerebro-.*\"}[5m])))",
          "legendFormat": "p95 — {{cerebro_agent_type}}"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 38,
  "tags": ["cerebro-hive", "executive", "leadership", "overview"],
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "CerebroHive — Executive Operations",
  "uid":   "cerebro-executive",
  "version": 1
}
