{"$schema":"http://json-schema.org/draft-07/schema#","$id":"external-mutation","type":"object","additionalProperties":false,"required":["schema_version","id","worktree_id","normalized_path","lane","first_observed_epoch","classification","first_size","current_size","first_sha256","current_sha256","dirty_set_digest","provenance_state","evidence","disposition","assigned_owner","adoption_authorization","first_observed_at","last_validated_at","collision","shared_infra","control","recovery","cross_product"],"properties":{"schema_version":{"type":"string"},"id":{"type":"string","minLength":1},"worktree_id":{"type":"string","minLength":1},"normalized_path":{"type":"string","pattern":"^(?:/|[A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$))"},"lane":{"type":"string","minLength":1},"first_observed_epoch":{"type":"integer","minimum":0},"classification":{"enum":["STAGED","UNSTAGED","UNTRACKED"]},"first_size":{"type":"integer","minimum":0},"current_size":{"type":"integer","minimum":0},"first_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"current_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"dirty_set_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"provenance_state":{"type":"string","minLength":1},"evidence":{"type":"array","minItems":1,"items":{"type":"string"}},"disposition":{"enum":["ADOPT_PRODUCT","ADOPT_RECOVERY","PRESERVE_EXTERNAL","CROSS_PRODUCT_DEPENDENCY","SHARED_INFRA","INVALID_FOR_LANE","UNRESOLVED"]},"assigned_owner":{"type":"string","minLength":1},"adoption_authorization":{"type":"string","minLength":1},"first_observed_at":{"type":"string","minLength":1},"last_validated_at":{"type":"string","minLength":1},"collision":{"type":"boolean"},"shared_infra":{"type":"boolean"},"control":{"type":"boolean"},"recovery":{"type":"boolean"},"cross_product":{"type":"boolean"}}}
