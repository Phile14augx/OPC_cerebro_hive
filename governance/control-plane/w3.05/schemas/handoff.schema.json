{"$schema":"http://json-schema.org/draft-07/schema#","$id":"handoff","type":"object","additionalProperties":false,"required":["schema_version","id","from_agent","to_agent","repository_id","worktree","branch","resources","revision_sha","dirty_state_digest","unfinished_task","acceptance_criteria","hazards","acknowledgement","timestamp","expires_at","status","supersedes"],"properties":{"schema_version":{"type":"string"},"id":{"type":"string","minLength":1},"from_agent":{"type":"string","minLength":1},"to_agent":{"type":"string","minLength":1},"repository_id":{"type":"string","minLength":1},"worktree":{"type":"string","pattern":"^(?!.*(?:^|/|\\\\)\\.\\.(?:/|\\\\|$))(?:/|[A-Za-z]:/)"},"branch":{"type":"string","minLength":1},"resources":{"type":"array","minItems":1,"items":{"type":"string"}},"revision_sha":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},"dirty_state_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"unfinished_task":{"type":"string","minLength":1},"acceptance_criteria":{"type":"array","minItems":1,"items":{"type":"string"}},"hazards":{"type":"array","items":{"type":"string"}},"acknowledgement":{"type":"boolean"},"timestamp":{"type":"string","minLength":1},"expires_at":{"type":"string","minLength":1},"status":{"type":"string","minLength":1},"supersedes":{"type":["string","null"]}}}
